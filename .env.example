# Copie para .env (git-ignored) e ajuste se quiser: cp .env.example .env
# Usado pelo docker-compose (serviço postgres) e pela API/Drizzle.

POSTGRES_USER=bamboo
POSTGRES_PASSWORD=bamboo
POSTGRES_DB=bamboo
POSTGRES_PORT=5432

# Connection string consumida pela API e pelo drizzle-kit.
DATABASE_URL=postgresql://bamboo:bamboo@localhost:5432/bamboo

# Credencial stub da nutri (Feature 006) — protege a via /nutri/* (adesão, ciclo,
# relatório, lista de pacientes). O guard é FAIL-CLOSED: sem esta env (ou vazia),
# a via da nutri nega tudo (403). O app do paciente nunca recebe esta chave.
# A web da nutri (apps/web, Feature 015) lê a MESMA env — só no servidor, nunca
# no browser (nada de prefixo NEXT_PUBLIC_).
NUTRI_API_KEY=nutri-dev-key

# API que a web da nutri consome (Feature 015).
# ⚠️ Os scripts da API discordam de porta: `pnpm --filter api dev` sobe na 3333;
# `pnpm --filter api start` (e o default do código, sem esta env) na 3000.
# O valor abaixo assume o `dev`, que é o que se roda no dia a dia — se você usa
# o `start`, troque para 3000. A web sobe na 3001, para não colidir com a API.
API_URL=http://localhost:3333
